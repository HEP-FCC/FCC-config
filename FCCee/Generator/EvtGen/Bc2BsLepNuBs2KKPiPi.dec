Alias   Bc_SIGNAL   B_c+
Alias   Bcbar_SIGNAL    B_c-
ChargeConj    Bc_SIGNAL   Bcbar_SIGNAL
#
Alias   MyB_s0   B_s0
Alias   Myanti-B_s0   anti-B_s0
ChargeConj    MyB_s0   Myanti-B_s0
#
Alias   MyD_s+   D_s+
Alias   MyD_s-   D_s-
ChargeConj    MyD_s+   MyD_s-
#
Alias   Myphi   phi
ChargeConj    Myphi   Myphi
#
Alias   MyK*0   K*0
Alias   Myanti-K*0   anti-K*0
ChargeConj    MyK*0   Myanti-K*0
#
Decay Bc_SIGNAL
# models as in the B_c+ block of DECAY.DEC, where the e and mu modes
# have equal BR (0.0403 each), so the 50:50 split is the physical ratio
    0.5   MyB_s0   mu+    nu_mu    PHOTOS  PHSP;
    0.5   MyB_s0   e+     nu_e     PHOTOS  PHSP;
Enddecay
CDecay    Bcbar_SIGNAL
#
Decay MyB_s0
# model as in the B_s0 block of DECAY.DEC
    1.0   MyD_s-   pi+    PHSP;
Enddecay
CDecay    Myanti-B_s0
#
Decay MyD_s-
# the two resonant paths to K+ K- pi-, in the ratio of their
# DECAY.DEC branching fractions (0.045 : 0.030491, renormalised)
    0.5961   Myphi   pi-    SVS;
    0.4039   MyK*0   K-     SVS;
Enddecay
CDecay    MyD_s+
#
Decay Myphi
    1.0   K+   K-    VSS;
Enddecay
#
Decay MyK*0
    1.0   K+   pi-    VSS;
Enddecay
CDecay    Myanti-K*0
End
