# ==============================================
# B0bar -> D0 omega
#          with D0 -> KK, Kspipi, Kspi0
# ==============================================

Alias Bd_SIGNAL       B0
Alias Bdbar_SIGNAL  anti-B0
ChargeConj Bd_SIGNAL  Bdbar_SIGNAL
Alias MyD0       D0
Alias Myanti-D0  anti-D0
ChargeConj MyD0  Myanti-D0
Alias Myomega omega
Alias MyK_S0 K_S0

Decay Bdbar_SIGNAL 
    1.000   Myomega MyD0 SVS;
Enddecay
CDecay Bd_SIGNAL

Decay MyD0 
    0.334   K+  K-  PHSP;
    0.333   MyK_S0 pi+ pi- D_DALITZ;
    0.333   MyK_S0 pi0 PHSP;
Enddecay
CDecay Myanti-D0

Decay Myomega
    1.000 pi+ pi- pi0 OMEGA_DALITZ;
Enddecay

# --- K_S0 decays (with PDG branching ratios)
Decay MyK_S0
    0.6920   pi+   pi-     PHSP;
    0.3069   pi0   pi0     PHSP;
    # We could include rare decays if desired 
    # 0.0007   pi-   e+   nu_e   PHSP;
Enddecay

End
