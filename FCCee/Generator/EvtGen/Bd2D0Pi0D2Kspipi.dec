# ==============================================
# B0bar -> D0 pi0
#          with D0 -> Kspipi
# ==============================================

Alias Bd_SIGNAL       B0
Alias Bdbar_SIGNAL  anti-B0
ChargeConj Bd_SIGNAL  Bdbar_SIGNAL
Alias MyD0       D0
Alias Myanti-D0  anti-D0
ChargeConj MyD0  Myanti-D0
Alias Mypi0 pi0
Alias MyK_S0 K_S0

Decay Bdbar_SIGNAL 
    1.000   MyD0  Mypi0 PHSP;
Enddecay
CDecay Bd_SIGNAL

Decay MyD0 
    1.000   MyK_S0  pi- pi+  D_DALITZ;
Enddecay
CDecay Myanti-D0

Decay Mypi0
    1.000 gamma gamma PHSP;
Enddecay

# --- K_S0 decays (with PDG branching ratios)
Decay MyK_S0
    0.6920   pi+   pi-     PHSP;
    0.3069   pi0   pi0     PHSP;
    # We could include rare decays if desired 
    # 0.0007   pi-   e+   nu_e   PHSP;
Enddecay

End
